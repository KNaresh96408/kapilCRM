rules_version = '2';

// Allow read and write access to the attachments collection only to authenticated users
service cloud.firestore {
  match /databases/{database}/documents {
    match /attachments/{attachmentId} {
      allow read, write: if request.auth != null;
    }

    // Allow read access to KPI-ID folders for all authenticated users
    match /kpiFolders/{kpiId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
    }

    // Allow read and write access to subfolders and files within KPI-ID folders
    match /kpiFolders/{kpiId}/subfolders/{subfolderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
    }

    match /kpiFolders/{kpiId}/subfolders/{subfolderId}/files/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
    }
  }
}